rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Images are read by signed-in members. Upload and removal run through
    // trusted Cloud Functions, which enforce the administrator check server-side.
    match /officialFeed/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
